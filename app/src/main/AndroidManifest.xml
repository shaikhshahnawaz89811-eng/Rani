<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:theme="@style/Theme.SADesktop" android:label="SA AI Desktop" android:allowBackup="false" android:supportsRtl="true">
        <!-- BUG FIX: screenOrientation="portrait" locked the desktop UI to portrait and blocked
             device rotation. Removing it lets Android choose portrait or landscape based on the
             device's actual configuration/sensor, per the required behavior. configChanges now
             also covers orientation/screenSize/screenLayout/smallestScreenSize so the Activity is
             not destroyed and recreated on rotation - Compose just recomposes with the new
             BoxWithConstraints dimensions, which is what lets DesktopWindowManager's existing
             clampToWorkspace/resizeWithinWorkspace keep windows on-screen without losing open
             windows, WebView state, or in-progress voice recognition. -->
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
